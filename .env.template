# Azure SQL Database Configuration
# Copy this file to .env and fill in your actual values

SQL_USER=
SQL_PASSWORD=
SQL_SERVER=
SQL_DATABASE=
SQL_POOL_MAX=5

# JWT Secret for authentication
JWT_SECRET=

# Node environment
NODE_ENV=development
PORT=3001
# Legacy AI is retired. Setting true refuses startup; the benchmark is separate.
QMT_AI_ENABLED=false
QMT_SPOND_ENABLED=false
QMT_SPOND_REVIEW_ENABLED=false
QMT_SPOND_REVIEW_APPROVED=false
# Reviewed publication also requires migration 006 and runtime journal permissions.
QMT_SPOND_PUBLISH_ENABLED=false
QMT_WEATHER_ENABLED=false
QMT_API_REQUESTS_PER_MINUTE=120
QMT_CLUB_NAME=QMT by errandom
QMT_TIMEZONE=Europe/Zurich
# Optional comma-separated HTTPS origins allowed to embed the public widget.
# Empty permits HTTPS websites. The operations app remains same-origin only.
QMT_EMBED_ORIGINS=
QMT_TRANSPORT_EMAIL=

# Optional club mailbox (Microsoft Graph application credentials).
# Mail.Send and Mail.Read must be limited to the designated club mailbox.
# Keep secrets in deployment secret settings, never in source control.
QMT_MAIL_TENANT_ID=
QMT_MAIL_CLIENT_ID=
QMT_MAIL_CLIENT_SECRET=
QMT_MAIL_SENDER=

# Optional default for assisted meeting-room entry, returned only to Operations users.
# Keep the actual sharing link in deployment settings, not in source control.
# Without this setting, an operator can save the workbook link with the request.
QMT_MEETING_ROOM_WORKBOOK_URL=
