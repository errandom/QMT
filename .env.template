# Azure SQL Database Configuration
# Copy this file to .env and fill in your actual values

SQL_USER=
SQL_PASSWORD=
SQL_SERVER=
SQL_DATABASE=
SQL_POOL_MAX=5

# JWT Secret for authentication
JWT_SECRET=

# Node environment
NODE_ENV=development
PORT=3001
# Legacy AI is retired. Setting true refuses startup; the benchmark is separate.
QMT_AI_ENABLED=false
QMT_SPOND_ENABLED=false
QMT_API_REQUESTS_PER_MINUTE=120
QMT_CLUB_NAME=QMT by errandom
QMT_TIMEZONE=Europe/Zurich
QMT_TRANSPORT_EMAIL=

# Optional club mailbox (Microsoft Graph application credentials).
# Mail.Send and Mail.Read must be limited to the designated club mailbox.
# Keep secrets in deployment secret settings, never in source control.
QMT_MAIL_TENANT_ID=
QMT_MAIL_CLIENT_ID=
QMT_MAIL_CLIENT_SECRET=
QMT_MAIL_SENDER=
